{
  "name": "snuffel",
  "version": "0.0.0",
  "private": true,
  "description": "Snuffel: a learning portal with short interactive lessons and homework help.",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "start": "npm run start -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "npm run test -w web",
    "e2e": "npm run e2e -w web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "privacy": "node tools/check-no-external-urls.mjs",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "pocketbase:fetch": "node tools/fetch-pocketbase.mjs",
    "check": "npm run format:check && npm run lint && npm run privacy && npm run test:tools && npm run typecheck && npm run test && npm run build",
    "verify": "npm run check && npm run e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{ts,js,mjs,html,css,json,md,yml,yaml}": "prettier --write",
    "web/{src,e2e}/**/*.{ts,html}": "eslint --fix"
  }
}
