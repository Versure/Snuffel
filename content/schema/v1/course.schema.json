{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snuffel:content:v1:course",
  "title": "Course",
  "description": "A course (learning path or practice set): course.json in content/courses/<course-id>/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "audience",
    "goal",
    "successCriterion",
    "kind",
    "ted",
    "lessons",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "audience": {
      "$ref": "#/$defs/text"
    },
    "goal": {
      "$ref": "#/$defs/text"
    },
    "successCriterion": {
      "$ref": "#/$defs/text"
    },
    "kind": {
      "description": "course: learning path; practice: homework practice for a school subject.",
      "type": "string",
      "enum": ["course", "practice"]
    },
    "subject": {
      "$ref": "#/$defs/text"
    },
    "schoolLevel": {
      "$ref": "#/$defs/text"
    },
    "method": {
      "$ref": "#/$defs/text"
    },
    "chapter": {
      "$ref": "#/$defs/text"
    },
    "ted": {
      "title": "CourseTed",
      "type": "object",
      "additionalProperties": false,
      "required": ["greeting"],
      "properties": {
        "greeting": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/courseLesson"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "practice"
      }
    },
    "required": ["kind"]
  },
  "then": {
    "properties": {
      "subject": true,
      "schoolLevel": true,
      "method": true,
      "chapter": true
    },
    "required": ["subject", "schoolLevel", "method", "chapter"]
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "courseLesson": {
      "title": "CourseLesson",
      "description": "A lesson entry in course.json. planned: id and title only; published: file required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "type": "string",
          "enum": ["planned", "published"]
        },
        "file": {
          "type": "string",
          "pattern": "^lessons/[0-9]{2}-[a-z0-9-]+\\.json$"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "file": true
        },
        "required": ["file"]
      },
      "else": {
        "properties": {
          "file": false
        }
      }
    },
    "source": {
      "title": "Source",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "publisher", "type", "reliability", "accessedOn"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "publisher": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "type": "string",
          "enum": [
            "government",
            "association",
            "education",
            "science",
            "media",
            "encyclopedia",
            "manufacturer",
            "shop",
            "blog",
            "forum",
            "method"
          ]
        },
        "reliability": {
          "description": "high: government, association, education, science; medium: established media, encyclopedia, manufacturer about its own product; low: shop, blog, forum.",
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "accessedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
